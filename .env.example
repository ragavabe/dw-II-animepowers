# ========================================================
# ANIME POWERS - EXEMPLO DE VARIÁVEIS DE AMBIENTE (.env.example)
# Copie este arquivo para .env e preencha com suas credenciais:
# cp .env.example .env
# ========================================================

# Configurações do Banco de Dados Principal (PostgreSQL / Relacional)
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=anime_powers_db
DB_USER=seu_usuario_postgres
DB_PASSWORD=sua_senha_segura
DB_SSL=false
DATABASE_URL=postgresql://seu_usuario:sua_senha@localhost:5432/anime_powers_db

# Configurações de Conexão e Pool de Dados
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_TIMEOUT=30000

# Backend / API Service
PORT=3001
API_SECRET_KEY=sua_chave_jwt_super_secreta
JWT_EXPIRES_IN=7d

# --------------------------------------------------------
# Variáveis de Ambiente para o Frontend Vite (Client-side)
# --------------------------------------------------------
VITE_APP_NAME="Anime Powers"
VITE_APP_VERSION="1.2.0"
VITE_API_URL=http://localhost:3001/api
VITE_DB_NAME="anime_powers_db"
VITE_DB_STORAGE_MODE="local_and_cloud"

# Serviços BaaS em Nuvem (Supabase / Firebase para sincronização remota opcional)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-public-key

# Google OAuth 2.0 Credentials
VITE_GOOGLE_CLIENT_ID="222156138599-ttteg9ra4duqmknbtlcc7rkvq2s01rhp.apps.googleusercontent.com"
GOOGLE_CLIENT_ID="222156138599-ttteg9ra4duqmknbtlcc7rkvq2s01rhp.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-seu-client-secret"
